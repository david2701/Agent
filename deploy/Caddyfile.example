# Add this block to your Caddyfile and reload Caddy (caddy reload).
# Caddy gets the HTTPS certificate, forwards WebSocket and streams the responses
# (text/event-stream) without buffering. Do not use "encode" here: Kairo already compresses
# its responses and compressing the stream would delay it.
#
# Kairo takes the client IP from the last value of X-Forwarded-For (the one Caddy adds) to
# limit login attempts. That is why port 8080 must only listen on
# localhost or on the Docker network (as in docker-compose.yml), never exposed to the Internet.
# If you put another proxy in front of Caddy (Cloudflare, a load balancer), declare it with
# "trusted_proxies" in Caddy's global options.

kairo.yourdomain.com {

    # HTTPS only for a year (Kairo also sends it if KAIRO_PUBLIC_URL starts with https).
    # "defer" leaves a single header even if Kairo sends it too.
    header {
        Strict-Transport-Security "max-age=31536000"
        defer
    }

    # Per-request cap: long audio and photos fit comfortably; it cuts huge bodies before they reach Kairo.
    request_body {
        max_size 50MB
    }

    # Caddy on the host:
    reverse_proxy 127.0.0.1:8080

    # Caddy in Docker joined to the "kairo" network (docker network connect kairo <caddy>):
    # reverse_proxy kairo:8080
}

# Optional: own push for the phones (docker compose --profile push up -d).
# It is the server that will deliver Kairo's notices with the app closed, without Firebase.
ntfy.yourdomain.com {
    reverse_proxy 127.0.0.1:8090
    # Caddy in Docker: reverse_proxy ntfy:80
}
