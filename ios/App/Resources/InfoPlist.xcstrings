{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairo sets the alarms and timers you ask it for."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairo pone las alarmas y los temporizadores que le pides."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To notify you when you arrive at or leave the places in your reminders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para avisarte al llegar o salir de los lugares de tus recordatorios."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To save places and give you the weather where you are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para guardar lugares y darte el clima de donde estás."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairo listens when you talk to it and records the meetings you ask it to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kairo te escucha cuando le hablas y graba las reuniones que le pides."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To recognize \"Hey Kairo\" on the phone itself, without sending audio until you say it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para reconocer \"Oye Kairo\" dentro del teléfono, sin enviar audio hasta que lo dices."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
