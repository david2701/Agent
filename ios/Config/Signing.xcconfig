// Ajusta estos valores una sola vez antes de compilar en tu Mac.
// Necesitas una cuenta del Apple Developer Program para push, App Groups, Live Activities y el reloj.

// Tu Team ID (Xcode > Settings > Accounts, o developer.apple.com > Membership)
DEVELOPMENT_TEAM =

// Identificador de la app. Debe ser único en tu cuenta (los widgets, compartir y el reloj cuelgan de él).
KAIRO_BUNDLE_ID = app.kairo.ios

// Contenedor compartido entre la app, los widgets y la extensión de compartir (Signing & Capabilities > App Groups)
KAIRO_APP_GROUP = group.app.kairo.ios
KAIRO_WATCH_APP_GROUP = group.app.kairo.ios

// Llavero compartido (la sesión de los widgets y de compartir)
KAIRO_KEYCHAIN_GROUP = app.kairo.ios.shared

// Servidor que aparece escrito en la pantalla de inicio de sesión (se puede cambiar ahí).
// Ejemplo: https:/$()/kairo.tudominio.com  (el "$()" evita que "//" se lea como comentario)
KAIRO_DEFAULT_SERVER =
