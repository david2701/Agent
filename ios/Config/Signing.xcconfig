// Set these values once before building on your Mac.
// You need an Apple Developer Program account for push, App Groups, Live Activities and the watch.

// Your Team ID (Xcode > Settings > Accounts, or developer.apple.com > Membership)
DEVELOPMENT_TEAM =

// App identifier. It must be unique in your account (the widgets, share extension and watch app hang from it).
KAIRO_BUNDLE_ID = app.kairo.ios

// Container shared by the app, the widgets and the share extension (Signing & Capabilities > App Groups)
KAIRO_APP_GROUP = group.app.kairo.ios
KAIRO_WATCH_APP_GROUP = group.app.kairo.ios

// Shared Keychain (the session of the widgets and the share extension)
KAIRO_KEYCHAIN_GROUP = app.kairo.ios.shared

// Server shown pre-filled on the sign-in screen (it can be changed there).
// Example: https:/$()/kairo.example.com  (the "$()" keeps "//" from being read as a comment)
KAIRO_DEFAULT_SERVER =
