# Copy this file to .env and fill in the values. Never commit .env to the repository.
# The easy way: ./scripts/generate-env.sh creates .env with all the secrets randomly generated.
# By hand, generate secrets with:  openssl rand -hex 32   and   openssl rand -base64 32
# Kairo will not start if the example values of KAIRO_JWT_SECRET, KAIRO_ENCRYPTION_KEY
# or KAIRO_OWNER_PASSWORD are left in place.

# --- Nan (AI provider) ---
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=sk-...

# --- Owner account (created on the first start) ---
# The password is only used the first time (at least 10 characters; do not keep the example one).
# Once the account exists you can delete it from here and change it in Settings > Security.
KAIRO_OWNER_EMAIL=you@example.com
KAIRO_OWNER_PASSWORD=a-long-password-here
KAIRO_OWNER_NAME=Your Name
KAIRO_TIMEZONE=America/Bogota

# --- Language ---
# Default language of the server's own texts (the owner account, and users whose language is "auto").
# en (default) or es. Each person can change theirs in Settings; new accounts take it from their browser/app.
KAIRO_DEFAULT_LANGUAGE=en

# --- Public URL (behind Caddy) ---
KAIRO_PUBLIC_URL=https://kairo.yourdomain.com

# --- Server secrets ---
# JWT: 32 random bytes, 64 hex characters (openssl rand -hex 32) or 43+ in base64 (openssl rand -base64 32).
KAIRO_JWT_SECRET=change-this-to-64-hex-characters
# Encryption of stored secrets (Google tokens, MCP headers): exactly 32 bytes in base64
# (openssl rand -base64 32). Do not change it afterwards: what was encrypted with the old one could no longer be read.
KAIRO_ENCRYPTION_KEY=change-this-to-32-bytes-in-base64=

# --- Database (docker compose creates the container) ---
KAIRO_DB_PASSWORD=change-this

# --- Optional: Google Calendar (see docs/GOOGLE_CALENDAR.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: own push without Firebase (UnifiedPush) ---
# docker compose --profile push up -d starts ntfy; phones use it to receive notices with the app closed.
# Kairo accepts push endpoints on this host even if it resolves to the local network (and reaches it without a proxy if it is local).
NTFY_PUBLIC_URL=https://ntfy.yourdomain.com
# Push endpoints on other hosts: https only and public addresses only. For tests or a local network:
# KAIRO_PUSH_ALLOW_HTTP=true      (accepts http://)
# KAIRO_PUSH_ALLOW_PRIVATE=true   (accepts private networks; never loopback or 169.254.x.x)

# --- Optional: also publish notices to an ntfy topic (for whoever uses the ntfy app directly) ---
# NTFY_TOPIC and NTFY_TOKEN belong to the owner (KAIRO_OWNER_EMAIL): the token is only used for their notices.
# The other members can set their own topic in Settings; it is published without a token (see docs/PUSH.md).
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Optional: MCP servers on your network (see docs/API.md, MCP servers section) ---
# For safety, Kairo only connects to MCP servers on public addresses. For one on your local network
# (for example Home Assistant at http://192.168.1.20:8123 or over Tailscale) enable:
# KAIRO_MCP_ALLOW_PRIVATE=true
# Loopback, 169.254.x.x and the internal services (db, kairo, ntfy, localhost) stay blocked; if you really
# need one of them (for example another container called "mcp-notion"), name it here, separated by commas:
# KAIRO_MCP_ALLOWED_HOSTS=

# --- Optional: Apple push (APNs) for the iPhone app (see docs/PUSH.md) ---
# .p8 key from developer.apple.com > Certificates, Identifiers & Profiles > Keys (Apple Push Notifications service).
# Without this the iPhone works just the same with its local alarms, the direct connection and background refresh.
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundle id of the iOS app (KAIRO_BUNDLE_ID in ios/Config/Signing.xcconfig), for example app.kairo.ios
APNS_TOPIC=
# The key: path to the .p8 file (with Docker, mount it in the container; see docker-compose.yml)...
APNS_PRIVATE_KEY_FILE=
# ...or its content on a single line, with \n for line breaks
APNS_PRIVATE_KEY=

# --- Backups (the "backup" service, in ./backups) ---
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
