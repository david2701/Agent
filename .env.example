# Copia este archivo a .env y completa los valores. Nunca subas .env al repositorio.
# Lo más fácil: ./scripts/generate-env.sh crea .env con todos los secretos aleatorios.
# A mano, genera secretos con:  openssl rand -hex 32   y   openssl rand -base64 32
# Kairo no arranca si deja aquí los valores de ejemplo de KAIRO_JWT_SECRET, KAIRO_ENCRYPTION_KEY
# o KAIRO_OWNER_PASSWORD.

# --- Nan (proveedor de IA) ---
NAN_BASE_URL=https://api.nan.builders/v1
NAN_API_KEY=sk-...

# --- Cuenta del propietario (se crea en el primer arranque) ---
# La contraseña sólo se usa la primera vez (al menos 10 caracteres; no dejes la de ejemplo).
# Cuando la cuenta ya existe puedes borrarla de aquí y cambiarla en Ajustes > Seguridad.
KAIRO_OWNER_EMAIL=tu@correo.com
KAIRO_OWNER_PASSWORD=una-contraseña-larga
KAIRO_OWNER_NAME=David
KAIRO_TIMEZONE=America/Bogota

# --- URL pública (detrás de Caddy) ---
KAIRO_PUBLIC_URL=https://kairo.tudominio.com

# --- Secretos del servidor ---
# JWT: 32 bytes aleatorios, 64 caracteres hex (openssl rand -hex 32) o 43+ en base64 (openssl rand -base64 32).
KAIRO_JWT_SECRET=cambia-esto-por-64-caracteres-hex
# Cifrado de secretos guardados (tokens de Google, cabeceras MCP): exactamente 32 bytes en base64
# (openssl rand -base64 32). No la cambies después: lo cifrado con la anterior dejaría de leerse.
KAIRO_ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64=

# --- Base de datos (docker compose crea el contenedor) ---
KAIRO_DB_PASSWORD=cambia-esto

# --- Opcional: Google Calendar (ver docs/GOOGLE_CALENDAR.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Opcional: push propio sin Firebase (UnifiedPush) ---
# docker compose --profile push up -d levanta ntfy; los teléfonos lo usan para recibir avisos con la app cerrada.
# Kairo acepta endpoints de push en este host aunque resuelva a la red local (y llega a él sin proxy si es local).
NTFY_PUBLIC_URL=https://ntfy.tudominio.com
# Endpoints de push en otros hosts: sólo https y sólo direcciones públicas. Para pruebas o una red local:
# KAIRO_PUSH_ALLOW_HTTP=true      (acepta http://)
# KAIRO_PUSH_ALLOW_PRIVATE=true   (acepta redes privadas; nunca loopback ni 169.254.x.x)

# --- Opcional: además, publicar avisos en un tema de ntfy (para quien use la app ntfy directamente) ---
# NTFY_TOPIC y NTFY_TOKEN son del propietario (KAIRO_OWNER_EMAIL): el token sólo se usa para sus avisos.
# Los demás miembros pueden poner su propio tema en Ajustes; se publica sin token (ver docs/PUSH.md).
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=

# --- Opcional: servidores MCP en tu red (ver docs/API.md#servidores-mcp) ---
# Por seguridad, Kairo sólo conecta servidores MCP en direcciones públicas. Para uno en tu red local
# (por ejemplo Home Assistant en http://192.168.1.20:8123 o por Tailscale) activa:
# KAIRO_MCP_ALLOW_PRIVATE=true
# Loopback, 169.254.x.x y los servicios internos (db, kairo, ntfy, localhost) siguen bloqueados; si de verdad
# necesitas uno de ellos (por ejemplo otro contenedor llamado "mcp-notion"), nómbralo aquí, separados por comas:
# KAIRO_MCP_ALLOWED_HOSTS=

# --- Opcional: push de Apple (APNs) para la app de iPhone (ver docs/PUSH.md) ---
# Clave .p8 de developer.apple.com > Certificates, Identifiers & Profiles > Keys (Apple Push Notifications service).
# Sin esto el iPhone funciona igual con sus alarmas locales, la conexión directa y la actualización en segundo plano.
APNS_KEY_ID=
APNS_TEAM_ID=
# Bundle id de la app de iOS (KAIRO_BUNDLE_ID en ios/Config/Signing.xcconfig), por ejemplo app.kairo.ios
APNS_TOPIC=
# La clave: ruta al archivo .p8 (con Docker, móntalo en el contenedor; ver docker-compose.yml)...
APNS_PRIVATE_KEY_FILE=
# ...o su contenido en una sola línea, con \n en los saltos de línea
APNS_PRIVATE_KEY=

# --- Copias de seguridad (servicio "backup", en ./backups) ---
BACKUP_TIME=03:30
BACKUP_KEEP_DAYS=14
