<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kairo" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/kairo_bg_light</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Kairo.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/kairo_ink</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Kairo</item>
    </style>

    <!-- Assistant overlay (long press, tile, widget) -->
    <style name="Theme.Kairo.Overlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.45</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
</resources>
